# ── Stash 64 Server Configuration ──
# Copy this to .env and fill in your values.
# NEVER commit .env to source control.

# Server
PORT=8080
DART_ENV=development  # Set to 'production' for production

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stash64
DB_USER=stash64
DB_PASSWORD=your_secure_password_here

# Google OAuth
# Create credentials at https://console.cloud.google.com/apis/credentials
# Use separate projects/clients for dev and production.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Allowed Origins (comma-separated, for CORS + CSRF in production)
# ALLOWED_ORIGINS=https://stash64.example.com

# JWT Secret (used internally — generate a strong random value)
# SERVER_JWT_SECRET=generate_a_secure_random_string_here
