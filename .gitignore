# Flutter
.dart_tool/
.packages
build/
.appimage-tools/
*.iml
.metadata
.flutter-plugins
.flutter-plugins-dependencies

# IDE
.idea/
.vscode/
*.swp
*.swo

# macOS
.DS_Store

# Linux build artifacts
linux/flutter/ephemeral/

# Android build artifacts
android/.gradle/
android/local.properties
android/key.properties
android/**/GeneratedPluginRegistrant.java
android/app/release/
android/app/debug/

# Locally-bootstrapped toolchain (Flutter SDK, Android SDK, appimagetool).
# Scripts under scripts/ download these on demand into .stash64-sdk/.
.stash64-sdk/

# We commit signed release artifacts under dist/ selectively — build output
# APKs/AppImages live in build/ first and are copied into dist/.
build/app/outputs/
# Keep dist/ tracked so pre-built releases are downloadable from GitHub,
# but ignore the scratch `.AppDir` + build caches that would otherwise
# land there. (The actual .apk / .AppImage files are NOT ignored.)
dist/*.AppDir/

# AppImage build scratch. The final .AppImage artifact is committed under
# dist/ for release downloads, so don't blanket-ignore it.
AppDir/
build/**/*.AppImage

# Pub
.pub-cache/
pubspec.lock

# Coverage
coverage/

# Generated
*.g.dart
*.freezed.dart

# Server
server/.dart_tool/
server/.env

# Secrets — never commit
.env
*.pem
*.key
