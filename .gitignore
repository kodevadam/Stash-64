# macOS
.DS_Store

# Linux build artifacts
linux/flutter/ephemeral/

# Android build artifacts
android/.gradle/
android/local.properties
android/key.properties
android/**/GeneratedPluginRegistrant.java
android/app/release/
android/app/debug/

# Locally-bootstrapped toolchain (Flutter SDK, Android SDK, appimagetool).
# Scripts under scripts/ download these on demand into .stash64-sdk/.
.stash64-sdk/

# We commit signed release artifacts under dist/ selectively — build output
# APKs/AppImages live in build/ first and are copied into dist/.
build/app/outputs/

# AppImage build
AppDir/
*.AppImage

# Pub
.pub-cache/
pubspec.lock

# Coverage
coverage/

# Generated
*.g.dart
*.freezed.dart

# Server
server/.dart_tool/
server/.env

# Secrets — never commit
.env
*.pem
*.key
